{
    "name": "streamonitor",
    "version-string": "2.0.0",
    "builtin-baseline": "c0991b94587f8493967303e45572cb187817cc9b",
    "description": "Stream monitoring and recording application with native FFmpeg, ImGui GUI",
    "overrides": [
        {
            "name": "ffmpeg",
            "version": "8.1",
            "port-version": 2
        }
    ],
    "dependencies": [
        {
            "name": "curl",
            "features": ["ssl", "sspi"],
            "platform": "windows"
        },
        {
            "name": "curl",
            "features": ["ssl"],
            "platform": "!windows"
        },
        "openssl",
        "nlohmann-json",
        {
            "name": "spdlog",
            "features": ["wchar"],
            "platform": "windows"
        },
        {
            "name": "spdlog",
            "platform": "!windows"
        },
        "fmt",
        {
            "name": "ffmpeg",
            "default-features": false,
            "features": [
                "avformat",
                "avcodec",
                "avfilter",
                "swscale",
                "swresample",
                "nvcodec",
                "x264",
                "openssl",
                "gpl"
            ]
        },
        "nghttp2"
    ]
}
